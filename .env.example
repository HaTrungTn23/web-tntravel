# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional compatibility with projects still using the legacy anon key name
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only keys. Never add NEXT_PUBLIC_ to these values.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# PostgreSQL connection used only by migration/maintenance commands.
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Only enable when deploying the Gmail-only demo registration flow.
# ENABLE_DEMO_GMAIL_SIGNUP=true
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional model overrides
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
